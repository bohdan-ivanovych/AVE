# Environment Variables for Autonomous Video Engine — AVE
# Copy this file to .env and fill in your values.
# All variables are optional — they override the defaults in config.yaml.

# ─── Browser Profile Paths ────────────────────────────────────────────────────

# Absolute path to your Chrome "User Data" directory.
# Default (Windows): C:\Users\<YourUser>\AppData\Local\Google\Chrome\User Data
# CHROME_BASE_PATH=C:\Users\YourUser\AppData\Local\Google\Chrome\User Data

# Absolute path to your Edge "User Data" directory (optional).
# EDGE_BASE_PATH=C:\Users\YourUser\AppData\Local\Microsoft\Edge\User Data
